{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "captions-extractor",
  "version": "0.1.0",
  "identifier": "killer545537",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "captions-extractor",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/yt-dlp"
    ]
  }
}
