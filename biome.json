{
    "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "vite.config.ts", "!src-tauri"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "a11y": {
                "noSvgWithoutTitle": "off",
                "noLabelWithoutControl": "off"
            },
            "suspicious": {
                "noArrayIndexKey": "off",
                "noUnknownAtRules": "off",
                "noImplicitAnyLet": "off",
                "noExplicitAny": "off"
            },
            "style": {
                "noNonNullAssertion": "off",
                "useImportType": "error"
            },
            "nursery": {
                "useExhaustiveSwitchCases": "error",
                "useConsistentArrowReturn": "error"
            }
        }
    },
    "css": {
        "linter": {
            "enabled": true
        },
        "parser": {
            "tailwindDirectives": true
        }
    },
    "javascript": {
        "formatter": {
            "jsxQuoteStyle": "single",
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
